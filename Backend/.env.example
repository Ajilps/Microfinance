PORT=4000
MONGO_URI=mongodb://localhost:27017/user_management

JWT_SECRET=your_jwt_secret_key_change_in_production
NODE_ENV=development

# Default admin credentials (used only if no admin user exists in the DB)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234

# Automatic completed 28-day interest periods
INTEREST_CRON_ENABLED=true
INTEREST_CRON_RUN_ON_STARTUP=true
INTEREST_CRON_SCHEDULE=10 0 * * *
INTEREST_CRON_TIMEZONE=Asia/Kolkata
