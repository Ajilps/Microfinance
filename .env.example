# Environment Variables Template

# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database Configuration
# ============================================
MONGODB_URI=mongodb://localhost:27017/microfinance
MONGO_USERNAME=admin
MONGO_PASSWORD=change_this_password

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_change_in_production
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRATION=30d

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================
# Redis Configuration (Optional)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# AWS S3 Configuration (Optional)
# ============================================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=microfinance-uploads
AWS_REGION=us-east-1

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=MicroFinance SaaS
VITE_APP_VERSION=2.0.0
